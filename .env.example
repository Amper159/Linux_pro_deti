# ---------------------------------------------------------------------------
# Linux pro deti - deployment configuration
# Copy this file to .env and adjust the values:  cp .env.example .env
# ---------------------------------------------------------------------------

# --- Flask -----------------------------------------------------------------

# Key used to sign session cookies. Generate once and keep it stable, otherwise
# every restart logs all users out:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Leave empty only for a single-worker test run: the app then generates a key
# into $SANDBOX_DATA/.flask_secret, which several workers may race to create.
SECRET_KEY=

# --- Persistent data -------------------------------------------------------

# Absolute HOST path for user homes, accounts and progress. It is mounted into
# the container under the very same path (see docker-compose.yml), so do not
# use a relative path here. Create it and hand it to APP_UID:APP_GID:
#   sudo mkdir -p /srv/linux-pro-deti/sandbox_data
#   sudo chown -R 1000:1000 /srv/linux-pro-deti/sandbox_data
SANDBOX_DATA=/srv/linux-pro-deti/sandbox_data

# --- Host identity ---------------------------------------------------------

# Host user owning SANDBOX_DATA. Sandbox containers run under this UID/GID, so
# files created inside them belong to it on the host.  Find it with: id -u; id -g
APP_UID=1000
APP_GID=1000

# GID of the host "docker" group; grants access to the mounted socket:
#   getent group docker | cut -d: -f3
DOCKER_GID=999

# --- Web server ------------------------------------------------------------

# Where gunicorn is published on the host. Keep 127.0.0.1 and put nginx/Caddy
# with TLS in front; 0.0.0.0 exposes the app to the internet unencrypted.
APP_BIND=127.0.0.1
APP_PORT=8000

# Gunicorn workers. Commands block a thread for up to 10 s, so favour threads
# over processes; 2 workers x 8 threads handles ~16 concurrent commands.
WEB_CONCURRENCY=2
GUNICORN_CMD_ARGS=--threads 8 --timeout 60 --graceful-timeout 30

# --- Sandbox ---------------------------------------------------------------

# Image of the minimal Linux the children get. Built automatically on first
# use; you can pre-build it:  docker build -t linux-pro-deti-sandbox:2 sandbox/docker
SANDBOX_IMAGE=linux-pro-deti-sandbox:2

# How many sandbox containers may run at once (each takes 128 MB RAM, 0.5 CPU).
# Roughly: (RAM of the VPS - 1 GB) / 128 MB.
SANDBOX_MAX_CONTAINERS=12

# Seconds of inactivity after which a sandbox container is removed. The user's
# home directory survives on disk.
SANDBOX_IDLE_TIMEOUT=1200

# --- Reverse proxy (optional: docker compose --profile proxy up -d) --------

# Public address Caddy serves. A bare hostname makes Caddy fetch and renew a
# Let's Encrypt certificate automatically - DNS must already point at this VPS
# and ports 80 + 443 must be open. Use ":80" to run plain HTTP without TLS.
SITE_ADDRESS=linuxhrou.cz

# ACME account e-mail for certificate expiry notices. Fill it in whenever
# SITE_ADDRESS is a hostname; it may stay empty for the ":80" variant.
ACME_EMAIL=admin@linuxhrou.cz

# Host ports for the proxy. Change only when something else already listens
# on 80/443 - Let's Encrypt always validates against the standard ports.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# --- Misc ------------------------------------------------------------------

# Timezone used in logs and in the daily login streak.
TZ=Europe/Prague
